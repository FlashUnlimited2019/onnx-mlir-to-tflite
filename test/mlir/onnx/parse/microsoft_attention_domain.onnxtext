// SPDX-License-Identifier: Apache-2.0

// RUN: onnx-mlir --EmitONNXBasic --useOnnxModelTypes=false --printIR %s | FileCheck %s

<
   ir_version: 8,
   opset_import: ["" : 24, "com.microsoft" : 1]
>
microsoft_attention (float[1,3,4] input, float[4,12] weights, float[12] bias) => (float[1,3,4] output) {
   output = com.microsoft.Attention <num_heads = 2, unidirectional = 0> (input, weights, bias)
}

// CHECK: "onnx.Custom"
// CHECK-SAME: function_name = "Attention"
// CHECK-SAME: domain_name = "com.microsoft"
// CHECK-NOT: "onnx.Attention"
